{
	"name": "twine-rs",
	"productName": "Twine RS",
	"version": "0.1.4",
	"twineCompatibilityVersion": "2.12.0",
	"description": "a GUI for creating nonlinear stories",
	"author": "Chris Klimas <chris@twinery.org>",
	"license": "GPL-3.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/klembot/twinejs"
	},
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.0",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.4",
		"@lezer/highlight": "^1.2.3",
		"@lukeed/uuid": "^2.0.1",
		"@popperjs/core": "^2.11.8",
		"@tabler/icons-react": "^3.44.0",
		"classnames": "^2.5.1",
		"detect-it": "^4.0.1",
		"extract-zip": "^2.0.1",
		"file-saver": "^2.0.5",
		"focus-trap-react": "12.0.3",
		"fs-extra": "^11.3.6",
		"i18next": "26.3.4",
		"i18next-http-backend": "^4.0.0",
		"jsonp": "^0.2.1",
		"lodash": "^4.17.21",
		"minimist": "^1.2.8",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-draggable": "^4.7.0",
		"react-hotkeys-hook": "5.3.3",
		"react-i18next": "17.0.8",
		"react-router": "7.18.1",
		"react-transition-group": "^4.4.5",
		"segseg": "^1.0.0",
		"semver": "^7.8.5",
		"ua-parser-js": "^0.7.41"
	},
	"devDependencies": {
		"@electron/notarize": "^3.1.1",
		"@eslint/js": "^9.39.5",
		"@faker-js/faker": "^10.5.0",
		"@playwright/test": "^1.61.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/electron-devtools-installer": "^2.2.0",
		"@types/file-saver": "^2.0.1",
		"@types/jest": "^30.0.0",
		"@types/jest-axe": "^3.5.9",
		"@types/jsonp": "^0.2.1",
		"@types/lodash": "^4.17.24",
		"@types/minimist": "^1.2.3",
		"@types/node": "^24.13.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/react-transition-group": "^4.4.12",
		"@types/semver": "^7.7.1",
		"@types/ua-parser-js": "^0.7.36",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"browserslist-to-esbuild": "^2.1.1",
		"cpy-cli": "^7.0.0",
		"electron": "^43.1.1",
		"electron-builder": "^26.15.3",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.15.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-testing-library": "^7.16.2",
		"jest": "^30.4.2",
		"jest-axe": "^10.0.0",
		"jest-canvas-mock": "^2.5.2",
		"jest-environment-jsdom": "^30.4.1",
		"jest-watch-typeahead": "^3.0.1",
		"npm-run-all2": "^9.0.2",
		"prettier": "^3.9.4",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.5",
		"vite-plugin-checker": "^0.14.4",
		"vite-plugin-pwa": "^1.3.0"
	},
	"scripts": {
		"build": "run-s clean build:electron-app:ci",
		"build:docs": "cd docs/en && mdbook build",
		"build:native": "node scripts/build-native.mjs",
		"build:wasm": "node scripts/build-wasm.mjs",
		"build:web": "tsc && vite build",
		"postbuild:web": "cpy --cwd \"dist/web\" \"./**\" \"../../electron-build/renderer\" && node scripts/archive-web.mjs",
		"build:electron": "npm-run-all --serial build:wasm build:web build:native build:electron-main",
		"build:electron-app": "NODE_ENV=production npm-run-all --serial build:wasm build:web build:native build:electron-main",
		"build:electron-app:ci": "npm-run-all --serial build:wasm build:web build:native build:electron-main",
		"build:electron-release": "npm-run-all --serial build:electron build:electron-bundle",
		"prebuild:electron-main": "rimraf electron-build/main",
		"build:electron-main": "tsc --project tsconfig.electron.json && node scripts/copy-native.mjs",
		"build:electron-bundle": "npm run release:clean && electron-builder --config electron-builder.config.js --publish=never && npm run release:organize",
		"release:clean": "node scripts/clean-release.mjs",
		"release:organize": "node scripts/organize-release.mjs",
		"bench:fixtures": "node benchmarks/generate-fixtures.mjs",
		"bench:fixtures:large": "node benchmarks/generate-fixtures.mjs --large",
		"clean": "rimraf dist electron-build release",
		"check:docs": "node scripts/check-documentation.mjs",
		"check:core-boundaries": "node scripts/check-core-mutation-boundaries.mjs",
		"check:no-codemirror5": "node scripts/check-no-codemirror5.mjs",
		"dist": "run-s clean build:electron-release",
		"e2e": "playwright test",
		"e2e:electron:packaged": "playwright test --config playwright.packaged-electron.config.ts",
		"electron:install": "install-electron",
		"package:electron:dir": "electron-builder --config electron-builder.config.js --dir --publish=never",
		"format": "prettier --write \"*.{js,json,ts,mts,html,md}\" \"src/**/*.{ts,tsx,js,jsx,css,json,md,html}\" \"scripts/**/*.{cjs,mjs}\" \"e2e/**/*.ts\" \"benchmarks/**/*.mjs\" \"public/locales/**/*.{json,md}\" \"docs/{README.md,architecture/**/*.md,decisions/**/*.md,status/**/*.md,roadmap/**/*.md,product/**/*.md,archive/**/*.md,upstream/README.md}\"",
		"format:check": "prettier --check \"*.{js,json,ts,mts,html,md}\" \"src/**/*.{ts,tsx,js,jsx,css,json,md,html}\" \"scripts/**/*.{cjs,mjs}\" \"e2e/**/*.ts\" \"benchmarks/**/*.mjs\" \"public/locales/**/*.{json,md}\" \"docs/{README.md,architecture/**/*.md,decisions/**/*.md,status/**/*.md,roadmap/**/*.md,product/**/*.md,archive/**/*.md,upstream/README.md}\"",
		"lint": "run-s check:core-boundaries check:no-codemirror5 check:docs lint:eslint",
		"lint:eslint": "eslint src",
		"perf:unit": "jest src/core/__tests__/graph-projection.parity.test.ts src/core/__tests__/wasm-worker-client.test.ts --runInBand",
		"perf:prepare": "npm-run-all --serial electron:install build:electron-app perf:prepare:fixtures",
		"perf:prepare:fixtures": "node benchmarks/prepare-project-fixtures.mjs --sizes 100,10000,50000",
		"perf:prepare:chapbook:10k": "node benchmarks/prepare-project-fixtures.mjs --sizes 10000 --variant chapbook",
		"perf:prepare:smoke": "npm-run-all --serial electron:install build:electron-app perf:prepare:smoke:fixture",
		"perf:prepare:smoke:fixture": "node benchmarks/prepare-project-fixtures.mjs --sizes 100",
		"perf:electron:smoke": "node benchmarks/run-electron-performance.mjs --size 100 --smoke",
		"perf:electron:memory": "npm-run-all --serial perf:electron:memory:100 perf:electron:memory:10k perf:electron:memory:50k perf:electron:memory:matrix",
		"perf:electron:memory:100": "node benchmarks/run-electron-performance.mjs --size 100 --phase startup",
		"perf:electron:memory:10k": "node benchmarks/run-electron-performance.mjs --size 10000 --phase startup",
		"perf:electron:memory:50k": "node benchmarks/run-electron-performance.mjs --size 50000 --phase startup",
		"perf:electron:memory:matrix": "node benchmarks/create-memory-matrix.mjs --require-clean",
		"perf:electron:memory:footprint:macos": "TWINE_PERF_FOOTPRINT=1 npm run perf:electron:memory",
		"perf:electron:memory-detail:100": "node benchmarks/run-electron-performance.mjs --size 100 --phase memory-detail --smoke",
		"perf:electron:memory-detail:10k": "node benchmarks/run-electron-performance.mjs --size 10000 --phase memory-detail --smoke",
		"perf:electron:memory-detail:50k": "node benchmarks/run-electron-performance.mjs --size 50000 --phase memory-detail --smoke",
		"perf:electron:chapbook:memory-detail:10k": "node benchmarks/run-electron-performance.mjs --size 10000 --variant chapbook --phase memory-detail --smoke",
		"perf:electron:10k": "node benchmarks/run-electron-performance.mjs --size 10000",
		"perf:electron:10k:diagnostic": "node benchmarks/run-electron-performance.mjs --size 10000 --phase diagnostic",
		"perf:electron:10k:edit": "node benchmarks/run-electron-performance.mjs --size 10000 --phase edit",
		"perf:electron:chapbook:10k:edit": "node benchmarks/run-electron-performance.mjs --size 10000 --variant chapbook --phase edit",
		"perf:electron:10k:query": "node benchmarks/run-electron-performance.mjs --size 10000 --phase query",
		"perf:electron:10k:startup": "node benchmarks/run-electron-performance.mjs --size 10000 --phase startup",
		"perf:electron:10k:graph": "node benchmarks/run-electron-performance.mjs --size 10000 --phase graph",
		"perf:electron:10k:watcher": "node benchmarks/run-electron-performance.mjs --size 10000 --phase watcher",
		"perf:electron:50k": "node benchmarks/run-electron-performance.mjs --size 50000",
		"perf:electron:50k:diagnostic": "node benchmarks/run-electron-performance.mjs --size 50000 --phase diagnostic",
		"perf:electron:50k:edit": "node benchmarks/run-electron-performance.mjs --size 50000 --phase edit",
		"perf:electron:50k:query": "node benchmarks/run-electron-performance.mjs --size 50000 --phase query",
		"perf:electron:50k:startup": "node benchmarks/run-electron-performance.mjs --size 50000 --phase startup",
		"perf:electron:50k:graph": "node benchmarks/run-electron-performance.mjs --size 50000 --phase graph",
		"perf:electron:50k:watcher": "node benchmarks/run-electron-performance.mjs --size 50000 --phase watcher",
		"perf:electron:all": "npm-run-all --serial perf:electron:10k perf:electron:50k",
		"perf:baseline": "node benchmarks/accept-baseline.mjs",
		"perf:bundle": "node benchmarks/check-editor-bundle.mjs",
		"perf:check": "node benchmarks/check-performance.mjs",
		"perf:reference": "node benchmarks/create-reference-summary.mjs",
		"perf:test": "node --test benchmarks/__tests__/*.test.mjs",
		"prestart:electron": "npm run electron:install",
		"start": "vite",
		"start:docs": "cd docs/en && mdbook serve",
		"start:electron": "NODE_ENV=development npm-run-all --serial clean build:wasm build:web build:native build:electron-main start:electron:boot",
		"start:electron:boot": "electron electron-build/main/src/electron/main-process/index.js",
		"test": "jest --watch",
		"test:ci": "run-s test:unit test:packaging",
		"test:coverage": "jest --coverage",
		"test:packaging": "node --test scripts/__tests__/*.test.mjs",
		"test:unit": "jest --watch=false --runInBand",
		"version:bump": "node scripts/version-bump.mjs"
	},
	"homepage": "./",
	"main": "electron-build/electron/src/electron/main-process/index.js"
}
